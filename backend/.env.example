# Copy to backend/.env for local development.
# On Vercel, set these under Project Settings -> Environment Variables.
# Never commit the real .env file.

# --- Required ---
# MongoDB connection string. Without it the backend refuses to start in
# production instead of silently falling back to localhost.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/subhadarshini_db?retryWrites=true&w=majority

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# --- Recommended ---
# Origin of the deployed frontend, used by the CORS allow-list.
FRONTEND_URL=https://subhadarsini-masala.vercel.app

# --- Optional ---
PORT=5000
# Leave NODE_ENV unset on Vercel (Vercel sets it to "production" itself).
# Setting it to "development" on a deployment leaks stack traces in API errors.
NODE_ENV=development

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis is optional — the API falls back to an in-process cache when unset.
# REDIS_URL=redis://localhost:6379

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
