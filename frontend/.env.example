# Copy to frontend/.env.local for local development (optional).
# On Vercel, set this under Project Settings -> Environment Variables.
#
# Base origin of the backend API, with no trailing slash and no /api suffix.
#
# Leave it EMPTY for local development: the Vite dev server proxies /api to
# http://127.0.0.1:5000 (see vite.config.ts).
#
# In a deployed build it must point at the backend deployment. If it is missing,
# the frontend falls back to the default production backend defined in
# src/config/api.ts.
VITE_API_URL=https://subhadarsini-masala-xs82-beta.vercel.app
